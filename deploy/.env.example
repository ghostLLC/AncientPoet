# Production template. Copy to deploy/.env (ignored) and supply real values.
# run_server.ps1 loads this file; the JVM itself does not load dotenv files.
APP_HOST=127.0.0.1
APP_PORT=8080
KTOR_DEVELOPMENT=false
AI_MODE=remote
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ancientpoet
POSTGRES_USER=ancientpoet
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_CHAT=deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=4096
LETTERS_PER_USER_PER_DAY=30
WORKER_POLL_MILLIS=1000
JOB_LEASE_SECONDS=180
SMS_PROVIDER=tencent
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SDK_APP_ID=
SMS_SIGN_NAME=鸿雁
SMS_TEMPLATE_CODE=
SMS_REGION=ap-guangzhou
SMS_PER_PHONE_PER_DAY=5
SMS_GLOBAL_PER_DAY=500
# Only the actual reverse proxy's socket addresses.
TRUSTED_PROXY_HOSTS=127.0.0.1,::1
CORS_ALLOWED_HOSTS=
ENABLE_COMMUNITY=false
ENABLE_UPLOADS=false
# Optional legacy REST adapter; Android v0.2 uses opt-in WorkManager checks.
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
