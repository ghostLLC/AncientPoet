# ========== 数据库 ==========
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ancientpoet
POSTGRES_USER=ancientpoet
POSTGRES_PASSWORD=your_secure_password_here

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== MinIO 对象存储 ==========
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ancientpoet

# ========== DeepSeek AI ==========
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_CHAT=deepseek-v4-flash
DEEPSEEK_MODEL_VISION=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=4096

# ========== JWT 认证 ==========
JWT_SECRET=your_jwt_secret_here_at_least_32_chars
JWT_ISSUER=ancientpoet
JWT_AUDIENCE=ancientpoet-client
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ========== SMS 短信 ==========
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=your_sms_access_key
SMS_ACCESS_SECRET=your_sms_access_secret
SMS_SIGN_NAME=鸿雁
SMS_TEMPLATE_CODE=SMS_000000

# ========== Firebase 推送 ==========
FCM_CREDENTIALS_PATH=./firebase-credentials.json

# ========== 应用配置 ==========
APP_PORT=8080
APP_HOST=0.0.0.0
